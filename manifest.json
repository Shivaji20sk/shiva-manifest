{
  "name": "Shiva.CMD",
  "short_name": "Shiva.CMD",
  "description": "The ultimate hub for multiple earning options including surveys, tasks, and freelancing opportunities.", 
  
  // 🔗 PWA कहाँ से शुरू होगी।
  "start_url": "/new-money-app/",
  
  // 🧭 PWA का स्कोप (दायरा)। यह सुनिश्चित करता है कि PWA के अंदर कौन से URL हैं।
  "scope": "/new-money-app/",
  
  // 📱 PWA को ब्राउज़र के बजाय Native App जैसा दिखाता है।
  "display": "standalone",
  
  // 🎨 PWA की थीम और बैकग्राउंड रंग।
  "background_color": "#ffffff",
  "theme_color": "#ff00ff",
  
  // 🔒 स्क्रीन ओरिएंटेशन (सीधा)।
  "orientation": "portrait", 
  
  // 🖼️ PWA आइकॉन्स।
  "icons": [
    {
      "src": "https://iili.io/f2nIJV4.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "https://iili.io/f2nIJV4.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "https://iili.io/f2nIJV4.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable" 
    }
  ],
  
  // ⚡ PWA आइकॉन को देर तक दबाने पर दिखने वाले क्विक एक्शन (Shortcuts)।
  "shortcuts": [
    {
      "name": "Start Earning Now",
      "short_name": "Earn Now",
      "description": "Quickly access the main earning dashboard.",
      "url": "/new-money-app/dashboard",
      "icons": [{"src": "https://iili.io/f2nIJV4.png", "sizes": "96x96"}]
    },
    {
      "name": "Check Wallet",
      "short_name": "Wallet",
      "description": "View your current balance and withdrawal history.",
      "url": "/new-money-app/wallet",
      "icons": [{"src": "https://iili.io/f2nIJV4.png", "sizes": "96x96"}]
    }
  ],
  
  // 🚫 यह सुनिश्चित करता है कि यह PWA है, Native App नहीं।
  "prefer_related_applications": false
}
